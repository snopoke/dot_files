############################################
# PROMPT
# https://bash-prompt-generator.org/
############################################
NIL='\[\e[0m\]'

function set_prompt {
    GIT='$(__git_ps1 " (%s)")'
    DATE="\[\e[2m\]\D{%Y-%m-%d} \t"
    PATH_=" \[\e[38;5;33m\]\w${NIL}"
    # Virtual Env
    if [[ $VIRTUAL_ENV != "" ]]
       then
           venv=" \[\033[31m\](${VIRTUAL_ENV##*/})${NIL}"
    else
       venv=''
    fi
    end="\[\e[38;5;28m\]\$${NIL}"
    export PS1="${DATE}${NIL}${venv}${GIT}${PATH_} ${end} "
    # simple ps1 for demos
    # export PS1="\[\e]0;\u@\h: \w\a\] ${end}"
}


export PROMPT_COMMAND=set_prompt


